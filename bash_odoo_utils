################################################################################
# odoo_module_uninstall [-h] <module_name>
################################################################################
odoo_module_uninstall() {
    if [[ "${1:-}" == "-h" || -z "${1:-}" ]]; then
        echo "Uninstall an Odoo module using the Odoo shell API"
        echo "Usage: odoo_module_uninstall <module_name>"
        return
    fi
    local module="$1"
    if [[ "$DRY_RUN" == "true" ]]; then
        print_dry_run "Uninstall module: $module"
        return 0
    fi
    confirm_action "Uninstall module $module from $DEFAULT_DB?" || return 0
    print_step "Uninstalling module via Odoo shell: $module"
    run_odoo "$ODOO_BIN_PATH shell -c $ODOO_CONF_PATH -d $DEFAULT_DB -q" <<UNINSTALL_EOF
env['ir.module.module'].search([('name', '=', '$module')]).button_immediate_uninstall()
UNINSTALL_EOF
    print_success "Module $module uninstalled"
}

################################################################################
# odoo_update_polimex_modules [-h] [-d <database>] [-m <module>]
# Legacy wrapper — uses update_custom_module internally
################################################################################
odoo_update_polimex_modules() {
    local database="$DEFAULT_DB"
    local module="hr_rfid"
    local repo_path="${ODOO_CUSTOM_ADDONS}/polimex-rfid"
    local extra_args=()

    while [[ "$#" -gt 0 ]]; do
        case $1 in
            -h|--help)
                echo "Usage: odoo_update_polimex_modules [options]"
                echo "Options:"
                echo "  -d, --database <name>   Database to update (default: $DEFAULT_DB)"
                echo "  -m, --module <name>     Module to update (default: hr_rfid)"
                return 0
                ;;
            -d|--database)
                if [[ -n "${2:-}" ]]; then
                    database="$2"
                    extra_args+=(--force)
                    shift
                else
                    print_error "Missing argument for $1"
                    return 1
                fi
                ;;
            -m|--module)
                if [[ -n "${2:-}" ]]; then
                    module="$2"
                    shift
                else
                    print_error "Missing argument for $1"
                    return 1
                fi
                ;;
            *)
                print_error "Unknown option: $1"
                return 1
                ;;
        esac
        shift
    done

    update_custom_module -m "$module" -r "$repo_path" -d "$database" "${extra_args[@]+"${extra_args[@]}"}"
}
