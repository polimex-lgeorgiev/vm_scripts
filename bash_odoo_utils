################################################################################
# odoo_log_search [-h] -p PATTERN [-n COUNT] [--level] [--since] [--until]
#                 [--module] [--traceback]
################################################################################
odoo_log_search() {
    if [[ "${1:-}" == "-h" ]]; then
        echo "Search for a pattern in Odoo logs (case insensitive)"
        echo "Usage: odoo_log_search -p PATTERN [-n COUNT] [--level LEVEL]"
        echo "                       [--since DATETIME] [--until DATETIME]"
        echo "                       [--module MODULE] [--traceback]"
        return
    fi
    local pattern="" count=50 level="" since="" until="" module="" traceback_flag="--no-traceback"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--pattern) pattern="$2"; shift ;;
            -n)           count="$2"; shift ;;
            --level)      level="$2"; shift ;;
            --since)      since="$2"; shift ;;
            --until)      until="$2"; shift ;;
            --module)     module="$2"; shift ;;
            --traceback)  traceback_flag="--traceback" ;;
        esac
        shift
    done

    if [[ -z "$pattern" ]]; then
        print_error "Pattern is required: odoo_log_search -p PATTERN"
        return 1
    fi

    local filter_args=(--pattern "$pattern" "$traceback_flag")
    [[ -n "$level" ]] && filter_args+=(--level "$level")
    [[ -n "$since" ]] && filter_args+=(--since "$since")
    [[ -n "$until" ]] && filter_args+=(--until "$until")
    [[ -n "$module" ]] && filter_args+=(--module "$module")

    print_info "Searching for '${pattern}' (last $count matches):"
    echo ""
    _log_filter "${filter_args[@]}" | tail -n "$count" | _colorize_log
}

################################################################################
# odoo_log_summary [-h] [--since DATETIME] [--until DATETIME]
################################################################################
odoo_log_summary() {
    if [[ "${1:-}" == "-h" ]]; then
        echo "Show log statistics summary"
        echo "Usage: odoo_log_summary [--since DATETIME] [--until DATETIME]"
        return
    fi
    local since="" until=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --since) since="$2"; shift ;;
            --until) until="$2"; shift ;;
        esac
        shift
    done

    local filter_args=(--no-traceback)
    [[ -n "$since" ]] && filter_args+=(--since "$since")
    [[ -n "$until" ]] && filter_args+=(--until "$until")

    print_step "Log Summary: $ODOO_LOG_PATH"

    # File info
    local file_size
    file_size=$(du -h "$ODOO_LOG_PATH" 2>/dev/null | cut -f1)
    local log_start log_end
    log_start=$(head -1 "$ODOO_LOG_PATH" 2>/dev/null | cut -d',' -f1)
    log_end=$(tail -1 "$ODOO_LOG_PATH" 2>/dev/null | cut -d',' -f1)
    echo -e "  ${_BOLD}File size:${_NC}  $file_size"
    echo -e "  ${_BOLD}Log range:${_NC}  $log_start → $log_end"
    [[ -n "$since" ]] && echo -e "  ${_BOLD}Since:${_NC}      $since"
    [[ -n "$until" ]] && echo -e "  ${_BOLD}Until:${_NC}      $until"
    echo ""

    # Counts
    local total errors warnings info
    total=$(_log_filter "${filter_args[@]}" | wc -l)
    errors=$(_log_filter "${filter_args[@]}" --level ERROR | wc -l)
    warnings=$(_log_filter "${filter_args[@]}" --level WARNING | wc -l)
    info=$(_log_filter "${filter_args[@]}" --level INFO | wc -l)

    echo -e "  ${_BOLD}Total lines:${_NC}  $total"
    echo -e "  ${_RED}Errors:${_NC}       $errors"
    echo -e "  ${_YELLOW}Warnings:${_NC}     $warnings"
    echo -e "  ${_BLUE}Info:${_NC}         $info"
    echo ""

    # Top error modules
    if [[ "$errors" -gt 0 ]]; then
        echo -e "  ${_RED}${_BOLD}Top error modules:${_NC}"
        _log_filter "${filter_args[@]}" --level ERROR \
            | grep -oP '\d+ ERROR \S+ \K\S+' | sed 's/:$//' \
            | sort | uniq -c | sort -rn | head -10 | while read -r cnt mod; do
                printf "    %5d  %s\n" "$cnt" "$mod"
            done
        echo ""
    fi

    # Top warning modules
    if [[ "$warnings" -gt 0 ]]; then
        echo -e "  ${_YELLOW}${_BOLD}Top warning modules:${_NC}"
        _log_filter "${filter_args[@]}" --level WARNING \
            | grep -oP '\d+ WARNING \S+ \K\S+' | sed 's/:$//' \
            | sort | uniq -c | sort -rn | head -10 | while read -r cnt mod; do
                printf "    %5d  %s\n" "$cnt" "$mod"
            done
        echo ""
    fi
}

