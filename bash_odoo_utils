################################################################################
# odoo_log_slow [-h] [-n COUNT] [-t THRESHOLD] [--since DATETIME]
################################################################################
odoo_log_slow() {
    if [[ "${1:-}" == "-h" ]]; then
        echo "Show slow HTTP requests from Odoo log"
        echo "Usage: odoo_log_slow [-n COUNT] [-t SECONDS] [--since DATETIME]"
        echo ""
        echo "Options:"
        echo "  -n COUNT       Number of entries (default: 20)"
        echo "  -t SECONDS     Threshold in seconds (default: 5.0)"
        echo "  --since DATE   Start time filter"
        return
    fi
    local count=20 threshold=5.0 since=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n)      count="$2"; shift ;;
            -t)      threshold="$2"; shift ;;
            --since) since="$2"; shift ;;
        esac
        shift
    done

    local filter_args=(--pattern "werkzeug:" --no-traceback)
    [[ -n "$since" ]] && filter_args+=(--since "$since")

    print_info "Slow requests (>${threshold}s), last $count:"
    echo ""
    _log_filter "${filter_args[@]}" \
        | awk -v thresh="$threshold" '{n=split($0,a," "); qt=a[n-1]; if (qt+0 >= thresh) print}' \
        | tail -n "$count" | while IFS= read -r line; do
            # Extract the query time (second to last field) and highlight it
            local qt
            qt=$(echo "$line" | awk '{print $(NF-1)}')
            echo -e "${_RED}[${qt}s]${_NC} $line"
        done
}

