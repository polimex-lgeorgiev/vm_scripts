    if [[ "$DRY_RUN" == "true" ]]; then
        print_dry_run "run_odoo: sudo -u $ODOO_USER bash -c \"source $ODOO_VENV && $*\""
        return 0
    fi
    sudo -u "$ODOO_USER" bash -c "source $ODOO_VENV && $*"
}

