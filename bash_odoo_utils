################################################################################
# odoo_backup_http [-h] [<db_name>]
################################################################################
odoo_backup_http() {
    if [[ "${1:-}" == "-h" ]]; then
        echo "Create a backup via Odoo's web controller"
        echo "Usage: odoo_backup_http [<db_name>]"
        echo "Defaults to DB: $DEFAULT_DB"
        return
    fi
    local db="${1:-$DEFAULT_DB}"
    local timestamp
    timestamp=$(date +'%Y%m%d_%H%M%S')
    local backup_file="${BACKUP_DIR}/backup_${db}_${timestamp}.zip"
    local start_time=$SECONDS

    check_disk_space "$BACKUP_DIR" 500 || return 1

    if [[ "$DRY_RUN" == "true" ]]; then
        print_dry_run "Create backup for DB: $db -> $backup_file"
        print_dry_run "POST to ${SOURCE_URL}/web/database/backup"
        return 0
    fi

    print_step "Creating backup for DB: $db"
    mkdir -p "$BACKUP_DIR"
    curl --silent -X POST \
        -F "master_pwd=$MASTER_PWD" \
        -F "name=$db" \
        -F "backup_format=zip" \
        -o "$backup_file" \
        "${SOURCE_URL}/web/database/backup"

    if validate_backup_file "$backup_file"; then
        local elapsed=$(( SECONDS - start_time ))
        print_success "Backup completed in $(format_duration $elapsed): $backup_file"
    else
        print_error "Backup validation failed"
        return 1
    fi
}

################################################################################
# odoo_restore_http [-h] [<source_db>] [<dest_db>] [<backup_file>]
################################################################################
odoo_restore_http() {
    if [[ "${1:-}" == "-h" ]]; then
        echo "Restore a DB from backup via Odoo's web controller"
        echo "Usage: odoo_restore_http [<source_db>] [<dest_db>] [<backup_file>]"
        echo "Defaults: source=$DEFAULT_DB, dest=${DEFAULT_DB}_restored"
        return
    fi
    local source_db="${1:-$DEFAULT_DB}"
    local dest_db="${2:-${DEFAULT_DB}_restored}"
    local backup_file="${3:-}"
    local start_time=$SECONDS

    # Find backup file if not provided
    if [[ -z "$backup_file" ]]; then
        print_info "Using latest backup from $BACKUP_DIR for DB: $source_db"
        backup_file=$(ls -t "${BACKUP_DIR}"/backup_"${source_db}"_*.zip 2>/dev/null | head -1)
        if [[ -z "$backup_file" ]]; then
            print_error "No backup file found for $source_db"
            return 1
        fi
    fi

    # Validations
    validate_pg_connection || return 1
    validate_backup_file "$backup_file" || return 1

    if [[ "$DRY_RUN" == "true" ]]; then
        print_dry_run "Restore $backup_file to $dest_db"
        print_dry_run "Terminate connections and drop $dest_db"
        print_dry_run "POST to ${DEST_URL}/web/database/restore"
        print_dry_run "Neutralize database $dest_db"
        return 0
    fi

    confirm_action "Restore $backup_file to database $dest_db? This will DROP the existing DB!" || return 0

    # Terminate connections and drop
    print_step "Preparing target database: $dest_db"
    terminate_db_connections "$dest_db"
    sudo -u "$ODOO_USER" dropdb --if-exists "$dest_db"
    sudo -u "$ODOO_USER" rm -rf "${ODOO_FILESTORE_PATH}/$dest_db"

    # Restore
    print_step "Restoring $backup_file to $dest_db"
    curl --silent -X POST \
        -F "master_pwd=$MASTER_PWD" \
        -F "backup_file=@${backup_file}" \
        -F "name=$dest_db" \
        -F "copy=true" \
        -F "neutralize_database=on" \
        "${DEST_URL}/web/database/restore"

    # Full neutralization
    neutralize_database "$dest_db"

    # Health check
    check_odoo_running || print_warning "Odoo may not be running"

    local elapsed=$(( SECONDS - start_time ))
    print_success "Restore complete in $(format_duration $elapsed): $dest_db"
}

################################################################################
# odoo_module_install [-h] <module_name>
################################################################################
odoo_module_install() {
    if [[ "${1:-}" == "-h" || -z "${1:-}" ]]; then
        echo "Install an Odoo module"
        echo "Usage: odoo_module_install <module_name>"
        return
    fi
    local module="$1"
    local start_time=$SECONDS
    if [[ "$DRY_RUN" == "true" ]]; then
        print_dry_run "Install module: $module"
        return 0
    fi
    print_step "Installing module: $module"
    run_odoo "$ODOO_BIN_PATH -c $ODOO_CONF_PATH -i $module --stop-after-init"
    local elapsed=$(( SECONDS - start_time ))
    print_success "Module $module installed in $(format_duration $elapsed)"
}

