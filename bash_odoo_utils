################################################################################
# GLOBAL CONFIGURATION
################################################################################
# Auto-detect: find odoo user from /opt/odoo* directory
_detect_odoo_user() {
    local dir
    for dir in /opt/odoo*/; do
        [[ -d "$dir" ]] && basename "$dir" && return
    done
    echo "odoo19"
}
ODOO_USER=${ODOO_USER:-$(_detect_odoo_user)}

# Auto-detect version from ODOO_USER (odoo19 → 19.0, odoo18 → 18.0)
_detect_odoo_version() {
    local num="${ODOO_USER//[!0-9]/}"
    [[ -n "$num" ]] && echo "${num}.0" || echo "19.0"
}
ODOO_VERSION=${ODOO_VERSION:-$(_detect_odoo_version)}

# All paths derived from ODOO_USER — no hardcoded version numbers
ODOO_BIN_PATH=${ODOO_BIN_PATH:-/opt/${ODOO_USER}/odoo/odoo-bin}
ODOO_CONF_PATH=${ODOO_CONF_PATH:-/etc/${ODOO_USER}.conf}
ODOO_SERVICE_NAME=${ODOO_SERVICE_NAME:-${ODOO_USER}}
ODOO_LOG_PATH=${ODOO_LOG_PATH:-/var/log/${ODOO_USER}.log}
ODOO_VENV=${ODOO_VENV:-/opt/${ODOO_USER}/venv/bin/activate}
ODOO_FILESTORE_PATH=${ODOO_FILESTORE_PATH:-/opt/${ODOO_USER}/.local/share/Odoo/filestore}
ODOO_SESSIONS_PATH=${ODOO_SESSIONS_PATH:-/opt/${ODOO_USER}/.local/share/Odoo/sessions}
ODOO_CUSTOM_ADDONS=${ODOO_CUSTOM_ADDONS:-/opt/${ODOO_USER}/custom-addons}
ODOO_ADDONS_DIR=${ODOO_ADDONS_DIR:-/opt/${ODOO_USER}/addons}
# Auto-detect HTTP port from config file
_detect_http_port() {
    local conf="${ODOO_CONF_PATH}"
    if [[ -r "$conf" ]]; then
        local port
        port=$(grep -E '^\s*http_port\s*=' "$conf" 2>/dev/null | sed 's/.*=\s*//' | tr -d '[:space:]')
        [[ -n "$port" ]] && echo "$port" && return
    fi
    echo "8069"
}
ODOO_HTTP_PORT=${ODOO_HTTP_PORT:-$(_detect_http_port)}
BACKUP_DIR=${BACKUP_DIR:-/home/$USER/odoo_backups}
BACKUP_RETENTION_DAYS=${BACKUP_RETENTION_DAYS:-7}
# Auto-detect master password from config file
_detect_master_pwd() {
    local conf="${ODOO_CONF_PATH}"
    if [[ -r "$conf" ]]; then
        local pwd
        pwd=$(grep -E '^\s*admin_passwd\s*=' "$conf" 2>/dev/null | sed 's/.*=\s*//' | tr -d '[:space:]')
        [[ -n "$pwd" ]] && echo "$pwd" && return
    fi
    echo "dbadmin"
}
MASTER_PWD=${MASTER_PWD:-$(_detect_master_pwd)}
# Auto-detect default database from config file
_detect_default_db() {
    local conf="${ODOO_CONF_PATH}"
    if [[ -r "$conf" ]]; then
        local db
        db=$(grep -E '^\s*db_name\s*=' "$conf" 2>/dev/null | sed 's/.*=\s*//' | tr -d '[:space:]')
        [[ -n "$db" ]] && echo "$db" && return
    fi
    echo "${ODOO_VERSION%%.*}_polimexodoo"
}
DEFAULT_DB=${DEFAULT_DB:-$(_detect_default_db)}
SOURCE_URL=${SOURCE_URL:-http://localhost:${ODOO_HTTP_PORT}}
DEST_URL=${DEST_URL:-http://localhost:${ODOO_HTTP_PORT}}
HEALTH_CHECK_TIMEOUT=${HEALTH_CHECK_TIMEOUT:-60}

# Global flags (set by parse_common_args or manually)
DRY_RUN=${DRY_RUN:-false}
VERBOSE=${VERBOSE:-false}
NO_CONFIRM=${NO_CONFIRM:-false}

################################################################################
# COLOR / OUTPUT
################################################################################
# Colors only when outputting to a terminal
if [[ -t 1 ]]; then
    _RED='\033[0;31m'
    _GREEN='\033[0;32m'
    _YELLOW='\033[1;33m'
    _BLUE='\033[0;34m'
    _CYAN='\033[0;36m'
    _BOLD='\033[1m'
    _NC='\033[0m'
else
    _RED='' _GREEN='' _YELLOW='' _BLUE='' _CYAN='' _BOLD='' _NC=''
fi

print_error()   { echo -e "${_RED}[ERROR]${_NC} $*" >&2; }
print_success() { echo -e "${_GREEN}[OK]${_NC} $*"; }
print_warning() { echo -e "${_YELLOW}[WARN]${_NC} $*"; }
print_info()    { echo -e "${_BLUE}[INFO]${_NC} $*"; }
print_step()    { echo -e "${_BOLD}${_CYAN}==>${_NC} ${_BOLD}$*${_NC}"; }
print_dry_run() { echo -e "${_YELLOW}[DRY RUN]${_NC} Would: $*"; }

################################################################################
# COMMON ARGS PARSER
# Usage: parse_common_args "$@" then set -- "${REMAINING_ARGS[@]+"${REMAINING_ARGS[@]}"}"
################################################################################
parse_common_args() {
    REMAINING_ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)  DRY_RUN=true ;;
            --verbose)  VERBOSE=true ;;
            --yes|-y)   NO_CONFIRM=true ;;
            *)          REMAINING_ARGS+=("$1") ;;
        esac
        shift
    done
}

################################################################################
# ERROR HANDLING & PROMPTS
################################################################################
# error_exit MESSAGE — prints error and returns 1 (no exit, safe for sourced files)
error_exit() {
    print_error "$*"
    return 1
}

# confirm_action MESSAGE — asks user to confirm, respects DRY_RUN and NO_CONFIRM
# Returns 0 if confirmed, 1 if declined
confirm_action() {
    local message="${1:-Continue?}"
    if [[ "$DRY_RUN" == "true" ]]; then
        print_dry_run "$message"
        return 1
    fi
    if [[ "$NO_CONFIRM" == "true" ]]; then
        return 0
    fi
    echo -en "${_YELLOW}[CONFIRM]${_NC} ${message} [y/N] "
    read -r answer
    [[ "$answer" =~ ^[Yy]$ ]]
}

# format_size BYTES — human-readable file size
format_size() {
    local bytes="${1:-0}"
    if [[ "$bytes" -ge 1073741824 ]]; then
        echo "$(( bytes / 1073741824 )) GB"
    elif [[ "$bytes" -ge 1048576 ]]; then
        echo "$(( bytes / 1048576 )) MB"
    elif [[ "$bytes" -ge 1024 ]]; then
        echo "$(( bytes / 1024 )) KB"
    else
        echo "${bytes} B"
    fi
}

# format_duration SECONDS — human-readable duration
format_duration() {
    local secs="${1:-0}"
    if [[ "$secs" -ge 3600 ]]; then
        printf '%dh %dm %ds' $((secs/3600)) $((secs%3600/60)) $((secs%60))
    elif [[ "$secs" -ge 60 ]]; then
        printf '%dm %ds' $((secs/60)) $((secs%60))
    else
        printf '%ds' "$secs"
    fi
}

################################################################################
# SYSTEM UTILITIES
################################################################################
# check_disk_space PATH MIN_MB — check available disk space
check_disk_space() {
    local path="${1:-.}" min_mb="${2:-500}"
    local avail_kb
    avail_kb=$(df -k "$path" 2>/dev/null | awk 'NR==2 {print $4}')
    if [[ -z "$avail_kb" ]]; then
        print_warning "Could not check disk space on $path"
        return 0
    fi
    local avail_mb=$(( avail_kb / 1024 ))
    if [[ "$avail_mb" -lt "$min_mb" ]]; then
        print_error "Insufficient disk space: ${avail_mb} MB available, ${min_mb} MB required on $path"
        return 1
    fi
    [[ "$VERBOSE" == "true" ]] && print_info "Disk space: ${avail_mb} MB available on $path"
    return 0
}

# check_odoo_running [TIMEOUT] — wait for Odoo HTTP to respond
check_odoo_running() {
    local timeout="${1:-$HEALTH_CHECK_TIMEOUT}"
    local port="${ODOO_HTTP_PORT}"
    local elapsed=0
    print_info "Waiting for Odoo to respond on port ${port}..."
    while [[ "$elapsed" -lt "$timeout" ]]; do
        if nc -z localhost "$port" 2>/dev/null; then
            print_success "Odoo is running (port ${port} responded after $(format_duration $elapsed))"
            return 0
        fi
        sleep 2
        elapsed=$((elapsed + 2))
    done
    print_error "Odoo did not respond on port ${port} within $(format_duration $timeout)"
    return 1
}

# require_command CMD — check that a command is available
require_command() {
    local cmd="$1"
    if ! command -v "$cmd" &>/dev/null; then
        print_error "Required command not found: $cmd"
        return 1
    fi
}

################################################################################
# DATABASE UTILITIES
################################################################################
# validate_pg_connection — check PostgreSQL connectivity
validate_pg_connection() {
    if ! sudo -u "$ODOO_USER" psql -d postgres -c "SELECT 1;" &>/dev/null; then
        print_error "Cannot connect to PostgreSQL as $ODOO_USER"
        return 1
    fi
    [[ "$VERBOSE" == "true" ]] && print_info "PostgreSQL connection OK"
    return 0
}

# terminate_db_connections DB_NAME — kill all active connections to a database
terminate_db_connections() {
    local db_name="$1"
    if [[ -z "$db_name" ]]; then
        print_error "terminate_db_connections: database name required"
        return 1
    fi
    if [[ "$DRY_RUN" == "true" ]]; then
        print_dry_run "Terminate connections to database: $db_name"
        return 0
    fi
    print_info "Terminating connections to: $db_name"
    sudo -u "$ODOO_USER" psql -d postgres -c \
        "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '${db_name}' AND pid <> pg_backend_pid();" \
        &>/dev/null
}

# db_exists DB_NAME — check if database exists
db_exists() {
    local db_name="$1"
    sudo -u "$ODOO_USER" psql -d postgres -tAc \
        "SELECT 1 FROM pg_database WHERE datname = '${db_name}';" 2>/dev/null | grep -q 1
}

# validate_backup_file FILE — check that a backup zip file is valid
validate_backup_file() {
    local file="$1"
    if [[ ! -f "$file" ]]; then
        print_error "Backup file not found: $file"
        return 1
    fi
    local size
    size=$(stat -c%s "$file" 2>/dev/null || echo 0)
    if [[ "$size" -eq 0 ]]; then
        print_error "Backup file is empty: $file"
        return 1
    fi
    if ! unzip -t "$file" &>/dev/null; then
        print_error "Backup file is corrupted: $file"
        return 1
    fi
    print_info "Backup file valid: $file ($(format_size "$size"))"
    return 0
}

################################################################################
# NEUTRALIZATION
################################################################################
# neutralize_database DB_NAME — full neutralization for restored databases
neutralize_database() {
    local db_name="$1"
    if [[ -z "$db_name" ]]; then
        print_error "neutralize_database: database name required"
        return 1
    fi
    if [[ "$DRY_RUN" == "true" ]]; then
        print_dry_run "Neutralize database: $db_name"
        return 0
    fi

    print_step "Neutralizing database: $db_name"

    sudo -u "$ODOO_USER" psql -d "$db_name" -v ON_ERROR_STOP=0 <<'NEUTRALIZE_SQL'
-- Mail servers: disable all outgoing
UPDATE ir_mail_server SET active = false;

-- Create a dummy mail server to prevent fallback
INSERT INTO ir_mail_server (name, smtp_host, smtp_port, smtp_encryption, active, sequence)
SELECT 'NEUTRALIZED - DO NOT USE', 'localhost', 1025, 'none', false, 999
WHERE NOT EXISTS (SELECT 1 FROM ir_mail_server WHERE name = 'NEUTRALIZED - DO NOT USE');

-- Fetchmail: disable all incoming
UPDATE fetchmail_server SET active = false;

-- Crons: disable all except autovacuum
UPDATE ir_cron SET active = false
WHERE id NOT IN (
    SELECT res_id FROM ir_model_data
    WHERE module = 'base' AND name = 'autovacuum_job'
);

-- Webhooks: disable
UPDATE base_automation SET active = false
WHERE trigger IN ('on_webhook', 'on_time', 'on_time_created', 'on_time_updated');

-- CDN: disable
UPDATE ir_config_parameter SET value = ''
WHERE key IN ('web.base.url.cdn', 'web.base.url.cdn.filters');

-- Domain: clear
UPDATE ir_config_parameter SET value = ''
WHERE key = 'mail.catchall.domain';

-- Robots.txt: disallow all
INSERT INTO ir_config_parameter (key, value)
VALUES ('website.robots.txt', E'User-agent: *\nDisallow: /')
ON CONFLICT (key) DO UPDATE SET value = E'User-agent: *\nDisallow: /';

-- IAP: disable
UPDATE iap_account SET account_token = 'disabled' WHERE account_token IS NOT NULL AND account_token != 'disabled';

-- Ribbon / dev mode indicator
INSERT INTO ir_config_parameter (key, value)
VALUES ('ribbon.name', 'TEST')
ON CONFLICT (key) DO UPDATE SET value = 'TEST';
NEUTRALIZE_SQL

    # web.base.url — set to local (outside heredoc to use variable)
    sudo -u "$ODOO_USER" psql -d "$db_name" -c \
        "UPDATE ir_config_parameter SET value = '${DEST_URL}' WHERE key = 'web.base.url';"

    print_success "Database neutralized: $db_name"
}

################################################################################
# DATABASE CLONE
################################################################################
# odoo_clone_db [-h] [SOURCE_DB] [DEST_DB] [--no-neutralize]
odoo_clone_db() {
    if [[ "${1:-}" == "-h" ]]; then
        echo "Clone an Odoo database using pg_dump/pg_restore + filestore copy"
        echo "Usage: odoo_clone_db [source_db] [dest_db] [--no-neutralize]"
        echo "Defaults: source=$DEFAULT_DB, dest=${DEFAULT_DB}_clone"
        return
    fi

    local source_db="${1:-$DEFAULT_DB}"
    local dest_db="${2:-${DEFAULT_DB}_clone}"
    local no_neutralize=false
    # Check for --no-neutralize in any position
    for arg in "$@"; do
        [[ "$arg" == "--no-neutralize" ]] && no_neutralize=true
    done

    local start_time=$SECONDS

    print_step "Clone database: $source_db -> $dest_db"

    # Pre-checks
    if ! db_exists "$source_db"; then
        print_error "Source database does not exist: $source_db"
        return 1
    fi

    if [[ "$DRY_RUN" == "true" ]]; then
        print_dry_run "pg_dump $source_db"
        print_dry_run "createdb $dest_db"
        print_dry_run "pg_restore into $dest_db"
        print_dry_run "Copy filestore: $source_db -> $dest_db"
        [[ "$no_neutralize" == "false" ]] && print_dry_run "Neutralize: $dest_db"
        return 0
    fi

    confirm_action "Clone '$source_db' to '$dest_db'? Existing '$dest_db' will be DROPPED!" || return 0

    # Terminate and drop dest
    terminate_db_connections "$dest_db"
    sudo -u "$ODOO_USER" dropdb --if-exists "$dest_db"
    sudo -u "$ODOO_USER" rm -rf "${ODOO_FILESTORE_PATH}/${dest_db}"

    # Dump source
    print_info "Dumping source database: $source_db"
    local tmp_dump
    tmp_dump=$(mktemp)
    sudo -u "$ODOO_USER" pg_dump --no-owner --format=c "$source_db" > "$tmp_dump"

    # Create and restore
    print_info "Creating target database: $dest_db"
    sudo -u "$ODOO_USER" createdb --encoding=UTF8 --locale=en_US.UTF-8 --template=template0 "$dest_db"
    sudo -u "$ODOO_USER" pg_restore --no-owner --dbname="$dest_db" "$tmp_dump" 2>/dev/null || true
    rm -f "$tmp_dump"
    print_success "Database restored"

    # Copy filestore
    local source_fs="${ODOO_FILESTORE_PATH}/${source_db}"
    local dest_fs="${ODOO_FILESTORE_PATH}/${dest_db}"
    if [[ -d "$source_fs" ]]; then
        print_info "Copying filestore..."
        sudo -u "$ODOO_USER" cp -a "$source_fs" "$dest_fs"
        print_success "Filestore copied"
    else
        print_warning "No source filestore found at $source_fs"
    fi

    # Neutralize
    if [[ "$no_neutralize" == "false" ]]; then
        neutralize_database "$dest_db"
    else
        print_warning "Neutralization skipped (--no-neutralize)"
    fi

    local elapsed=$(( SECONDS - start_time ))
    print_success "Clone complete in $(format_duration $elapsed): $source_db -> $dest_db"
}

################################################################################
# SYMLINK MANAGEMENT
################################################################################
# sync_repo_symlinks REPO_PATH — create missing symlinks, remove dead ones
sync_repo_symlinks() {
    local repo_path="$1"
    local created=0 removed=0

    if [[ ! -d "$repo_path" ]]; then
        print_warning "Repo path does not exist: $repo_path"
        return 0
    fi

    # Create missing symlinks for modules in this repo
    sudo -u "$ODOO_USER" find "$repo_path" -maxdepth 2 -type f -name "__manifest__.py" -exec dirname {} \; | while read -r mod_dir; do
        local mod_name
        mod_name=$(basename "$mod_dir")
        local symlink="${ODOO_ADDONS_DIR}/${mod_name}"
        if [[ ! -e "$symlink" ]]; then
            local rel_target
            rel_target=$(realpath --relative-to="$ODOO_ADDONS_DIR" "$mod_dir")
            if [[ "$DRY_RUN" == "true" ]]; then
                print_dry_run "ln -s $rel_target $symlink"
            else
                sudo -u "$ODOO_USER" ln -s "$rel_target" "$symlink"
                print_success "New symlink: $mod_name"
            fi
            created=$((created + 1))
        fi
    done

    # Remove dead symlinks in addons dir (pointing to this repo)
    for symlink in "${ODOO_ADDONS_DIR}"/*; do
        [[ -L "$symlink" ]] || continue
        local target
        target=$(readlink -f "$symlink" 2>/dev/null || true)
        # Only clean symlinks that belong to this repo
        if [[ "$target" == "${repo_path}"* && ! -e "$symlink" ]]; then
            local dead_name
            dead_name=$(basename "$symlink")
            if [[ "$DRY_RUN" == "true" ]]; then
                print_dry_run "Remove dead symlink: $dead_name"
            else
                sudo -u "$ODOO_USER" rm -f "$symlink"
                print_warning "Removed dead symlink: $dead_name"
            fi
            removed=$((removed + 1))
        fi
    done

    if [[ "$created" -gt 0 || "$removed" -gt 0 ]]; then
        print_info "Symlinks: $created created, $removed removed"
    else
        print_info "Symlinks up to date"
    fi
}

################################################################################
# SHARED GITHUB DEPLOY KEY (read-only) for private Polimex repos
# Older installs cannot register their own deploy key (GitHub allows a key on
# exactly one repo), so they reuse the shared read-only key shipped in
# vm_scripts/keys/. ensure_odoo_ssh_key installs/refreshes it for ODOO_USER.
################################################################################
VM_SCRIPTS_KEYS_DIR="${VM_SCRIPTS_KEYS_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/keys}"
SHARED_DEPLOY_KEY="${SHARED_DEPLOY_KEY:-${VM_SCRIPTS_KEYS_DIR}/polimex_ws_deploy}"

ensure_odoo_ssh_key() {
    local odoo_home ssh_dir key
    if [[ "$DRY_RUN" == "true" ]]; then
        print_dry_run "Install/refresh shared deploy key for $ODOO_USER + github.com known_hosts"
        return 0
    fi
    odoo_home=$(getent passwd "$ODOO_USER" | cut -d: -f6 || true)
    if [[ -z "$odoo_home" ]]; then
        print_error "Cannot determine home directory for $ODOO_USER"
        return 1
    fi
    ssh_dir="${odoo_home}/.ssh"
    key="${ssh_dir}/id_ed25519"
    if [[ ! -f "$SHARED_DEPLOY_KEY" ]]; then
        print_error "Bundled deploy key missing: $SHARED_DEPLOY_KEY (git pull vm_scripts?)"
        return 1
    fi

    sudo -u "$ODOO_USER" mkdir -p "$ssh_dir"
    sudo chmod 700 "$ssh_dir"

    # Install when missing; replace when it differs from the bundled key
    # (bundled key is canonical — this doubles as the rotation mechanism)
    if ! sudo -u "$ODOO_USER" test -f "${key}.pub" || \
       ! sudo diff -q "${key}.pub" "${SHARED_DEPLOY_KEY}.pub" &>/dev/null; then
        if sudo -u "$ODOO_USER" test -f "$key"; then
            print_warning "SSH key of $ODOO_USER differs from bundled deploy key — replacing"
        fi
        sudo install -o "$ODOO_USER" -g "$ODOO_USER" -m 600 "$SHARED_DEPLOY_KEY" "$key"
        sudo install -o "$ODOO_USER" -g "$ODOO_USER" -m 644 "${SHARED_DEPLOY_KEY}.pub" "${key}.pub"
        print_success "Shared deploy key installed for $ODOO_USER"
    fi

    # github.com host key (avoid interactive prompt on first clone/fetch)
    if ! sudo -u "$ODOO_USER" ssh-keygen -F github.com -f "${ssh_dir}/known_hosts" &>/dev/null; then
        sudo -u "$ODOO_USER" bash -c \
            "ssh-keyscan -t ed25519 github.com >> '${ssh_dir}/known_hosts' 2>/dev/null && chmod 600 '${ssh_dir}/known_hosts'"
        print_info "Added github.com to known_hosts of $ODOO_USER"
    fi
}

################################################################################
# clone_custom_repo REPO_PATH GIT_URL [BRANCH]
# Clones a missing custom-addons repo as ODOO_USER. git@ URLs use the shared
# deploy key (ensure_odoo_ssh_key). BRANCH defaults to ODOO_VERSION.
################################################################################
clone_custom_repo() {
    local repo_path="$1" git_url="$2" branch="${3:-$ODOO_VERSION}"
    if [[ "$DRY_RUN" == "true" ]]; then
        print_dry_run "git clone -b $branch $git_url $repo_path (as $ODOO_USER)"
        return 0
    fi
    if [[ "$git_url" == git@* || "$git_url" == ssh://* ]]; then
        ensure_odoo_ssh_key || return 1
    fi
    print_step "Cloning $(basename "$repo_path") from $git_url (branch $branch)"
    if ! sudo -u "$ODOO_USER" git clone -b "$branch" "$git_url" "$repo_path"; then
        print_error "Clone failed: $git_url"
        return 1
    fi
    print_success "Cloned $(basename "$repo_path")"
}

################################################################################
# MODULE UPDATE (for update_*_modules.sh thin wrappers)
################################################################################
# update_custom_module -m MODULE -r REPO_PATH [-d DB] [--force]
update_custom_module() {
    local module="" repo_path="" database="$DEFAULT_DB" force=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m|--module)    module="$2"; shift ;;
            -r|--repo)      repo_path="$2"; shift ;;
            -d|--database)  database="$2"; force=true; shift ;;
            --force)        force=true ;;
            -h|--help)
                echo "Usage: update_custom_module -m MODULE -r REPO_PATH [-d DB] [--force]"
                return 0
                ;;
            *) print_error "Unknown option: $1"; return 1 ;;
        esac
        shift
    done

    if [[ -z "$module" || -z "$repo_path" ]]; then
        print_error "update_custom_module: -m MODULE and -r REPO_PATH are required"
        return 1
    fi

    local start_time=$SECONDS

    # Fetch and compare
    print_step "Checking for updates: $module"
    if [[ "$DRY_RUN" == "true" ]]; then
        print_dry_run "git fetch in $repo_path"
        print_dry_run "Sync symlinks from $repo_path"
        print_dry_run "Stop service $ODOO_SERVICE_NAME"
        print_dry_run "git pull in $repo_path"
        print_dry_run "Sync symlinks (post-pull)"
        print_dry_run "odoo-bin -u $module -d $database"
        print_dry_run "Clear sessions"
        print_dry_run "Start service $ODOO_SERVICE_NAME"
        return 0
    fi

    # Explicit check: errexit is suspended when this function is called in a
    # ||/&& context, so a failed fetch must not fall through to "No updates"
    if ! sudo -u "$ODOO_USER" bash -c "cd '$repo_path' && git fetch"; then
        print_error "git fetch failed for $module — check network access / repository key"
        return 1
    fi
    local local_rev remote_rev
    local_rev=$(sudo -u "$ODOO_USER" bash -c "cd '$repo_path' && git rev-parse @")
    remote_rev=$(sudo -u "$ODOO_USER" bash -c "cd '$repo_path' && git rev-parse @{u}")

    # Always sync symlinks (even without git changes)
    print_step "Syncing symlinks"
    sync_repo_symlinks "$repo_path"

    if [[ "$force" == "false" && "$local_rev" == "$remote_rev" ]]; then
        print_info "No updates for $module. Skipping."
        return 0
    fi

    # Module not installed in this DB → code-only update: pull + symlinks,
    # no service stop and no -u (upgrading an uninstalled module is a full
    # registry reload for nothing).
    local installed
    installed=$(sudo -u "$ODOO_USER" psql -d "$database" -tAc \
        "SELECT 1 FROM ir_module_module WHERE name = '$module' AND state IN ('installed', 'to upgrade', 'to install')" 2>/dev/null || true)
    if [[ "$installed" != "1" ]]; then
        print_warning "Module $module is not installed in $database — updating code only (no -u, no restart)"
        sudo -u "$ODOO_USER" bash -c "cd '$repo_path' && git pull --ff-only"
        sync_repo_symlinks "$repo_path"
        print_success "Repo $(basename "$repo_path") updated; module $module awaits installation"
        return 0
    fi

    # Stop service
    print_step "Stopping Odoo service"
    sudo systemctl stop "$ODOO_SERVICE_NAME"

    # Pull changes (--ff-only: local drift must fail loudly, not silently merge)
    print_step "Pulling latest changes for $module"
    sudo -u "$ODOO_USER" bash -c "cd '$repo_path' && git pull --ff-only"

    # Sync symlinks again after pull (new/removed modules)
    print_step "Syncing symlinks (post-pull)"
    sync_repo_symlinks "$repo_path"

    # Update module — capture log output and check for errors
    print_step "Updating $module in DB $database"
    local log_before
    log_before=$(wc -l < "$ODOO_LOG_PATH" 2>/dev/null || echo 0)

    run_odoo "$ODOO_BIN_PATH -c $ODOO_CONF_PATH -d '$database' -u '$module' --stop-after-init"
    local update_exit=$?

    # Show log output from the update
    local log_after
    log_after=$(wc -l < "$ODOO_LOG_PATH" 2>/dev/null || echo 0)
    local new_lines=$(( log_after - log_before ))
    if [[ "$new_lines" -gt 0 ]]; then
        echo ""
        print_info "--- odoo-bin update log ($new_lines lines) ---"
        tail -n "$new_lines" "$ODOO_LOG_PATH" | _colorize_log
        echo ""
    fi

    # Check for errors in the update log
    local update_errors=0
    if [[ "$new_lines" -gt 0 ]]; then
        update_errors=$(tail -n "$new_lines" "$ODOO_LOG_PATH" | grep -c ' ERROR ' || true)
    fi
    # Fully unattended error handling — the client must never be left with a
    # stopped server or an open question:
    #  - odoo-bin failed (exit != 0): DB upgrade aborted -> roll the CODE back
    #    to the previous revision and start on the known-good version
    #  - odoo-bin succeeded but ERROR lines in log: DB is upgraded -> keep the
    #    new code (rolling back now would mismatch the schema), start and warn
    if [[ "$update_exit" -ne 0 ]]; then
        print_error "Module update failed! (exit code: $update_exit, $update_errors error(s) in log)"
        print_warning "Rolling back $module code to the previous version"
        sudo -u "$ODOO_USER" bash -c "cd '$repo_path' && git reset --hard '$local_rev'"
        sync_repo_symlinks "$repo_path"
        sudo systemctl start "$ODOO_SERVICE_NAME"
        check_odoo_running || true
        print_warning "System restored to the previous version and started — contact Polimex support"
        return 1
    fi
    if [[ "$update_errors" -gt 0 ]]; then
        print_error "Update finished with $update_errors error line(s) in the log"
        sudo systemctl start "$ODOO_SERVICE_NAME"
        check_odoo_running || true
        print_warning "System started on the new version — review the log above / contact Polimex support"
        return 1
    fi

    print_success "Module update completed successfully"

    # Clear sessions
    print_info "Clearing sessions"
    sudo -u "$ODOO_USER" bash -c "rm -f ${ODOO_SESSIONS_PATH}/*.sess"

    # Start service (unattended — no prompts, the update must be transparent)
    print_step "Starting Odoo service"
    sudo systemctl start "$ODOO_SERVICE_NAME"
    check_odoo_running || print_warning "Odoo may not have started correctly"

    local elapsed=$(( SECONDS - start_time ))
    print_success "Module $module updated in $(format_duration $elapsed)"
}

