################################################################################
# odoo_logs [-h] [-n LINES]
################################################################################
odoo_logs() {
    if [[ "${1:-}" == "-h" ]]; then
        echo "Tail Odoo log file"
        echo "Usage: odoo_logs [-n LINES]"
        return
    fi
    local lines=50
    if [[ "${1:-}" == "-n" && -n "${2:-}" ]]; then
        lines="$2"
    fi
    print_info "Tailing log file: $ODOO_LOG_PATH (last $lines lines)"
    sudo tail -f -n "$lines" "$ODOO_LOG_PATH"
}

################################################################################
# odoo_errors [-h] [-n COUNT] — show last N errors and warnings from log
################################################################################
odoo_errors() {
    if [[ "${1:-}" == "-h" ]]; then
        echo "Show last N errors and warnings from Odoo log"
        echo "Usage: odoo_errors [-n COUNT]"
        echo "Default: last 20 errors/warnings"
        return
    fi
    local count=20
    if [[ "${1:-}" == "-n" && -n "${2:-}" ]]; then
        count="$2"
    fi
    print_info "Last $count errors/warnings from $ODOO_LOG_PATH:"
    echo ""
    sudo grep -E '\b(ERROR|WARNING|CRITICAL)\b' "$ODOO_LOG_PATH" | tail -n "$count" | while IFS= read -r line; do
        if echo "$line" | grep -qE '\bCRITICAL\b'; then
            echo -e "${_RED}${_BOLD}${line}${_NC}"
        elif echo "$line" | grep -qE '\bERROR\b'; then
            echo -e "${_RED}${line}${_NC}"
        else
            echo -e "${_YELLOW}${line}${_NC}"
        fi
    done
}

