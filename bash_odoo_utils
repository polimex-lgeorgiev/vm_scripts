################################################################################
# LOG ANALYSIS FUNCTIONS
# Inspired by odoo_logs.py — local versions for on-premise VM use
################################################################################

# _log_filter — internal helper to build a filtered log stream
# Usage: _log_filter [--level LEVEL] [--since DATETIME] [--until DATETIME]
#                    [--module MODULE] [--pattern PATTERN] [--no-traceback]
# Outputs filtered lines to stdout
_log_filter() {
    local level="" since="" until="" module="" pattern="" no_traceback=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --level)        level="$2"; shift ;;
            --since)        since="$2"; shift ;;
            --until)        until="$2"; shift ;;
            --module)       module="$2"; shift ;;
            --pattern)      pattern="$2"; shift ;;
            --traceback)    no_traceback=false ;;
            --no-traceback) no_traceback=true ;;
        esac
        shift
    done

    local cmd="cat '$ODOO_LOG_PATH'"

    # Level filter (ERROR, WARNING, INFO, DEBUG)
    if [[ -n "$level" ]]; then
        cmd+=" | grep ' ${level} '"
    fi

    # Module filter (e.g., odoo.addons.sale, werkzeug)
    if [[ -n "$module" ]]; then
        cmd+=" | grep '${module}:'"
    fi

    # Pattern filter (case insensitive)
    if [[ -n "$pattern" ]]; then
        cmd+=" | grep -i '${pattern}'"
    fi

    # Time range filters via awk
    if [[ -n "$since" || -n "$until" ]]; then
        local awk_cond=""
        [[ -n "$since" ]] && awk_cond="\$1\" \"\$2 >= \"${since}\""
        if [[ -n "$until" ]]; then
            [[ -n "$awk_cond" ]] && awk_cond+=" && "
            awk_cond+="\$1\" \"\$2 <= \"${until}\""
        fi
        cmd+=" | awk '/^[0-9]{4}-[0-9]{2}-[0-9]{2}/ && ${awk_cond} {print; next} !/^[0-9]{4}-[0-9]{2}-[0-9]{2}/ {print}'"
    fi

    # Strip traceback continuation lines (keep only dated log lines)
    if [[ "$no_traceback" == "true" ]]; then
        cmd+=" | grep '^[0-9]\\{4\\}-[0-9]\\{2\\}-[0-9]\\{2\\} '"
    fi

    eval "$cmd" 2>/dev/null
}

# _colorize_log — colorize log lines by level
_colorize_log() {
    while IFS= read -r line; do
        if [[ "$line" == *" CRITICAL "* ]]; then
            echo -e "${_RED}${_BOLD}${line}${_NC}"
        elif [[ "$line" == *" ERROR "* ]]; then
            echo -e "${_RED}${line}${_NC}"
        elif [[ "$line" == *" WARNING "* ]]; then
            echo -e "${_YELLOW}${line}${_NC}"
        else
            echo "$line"
        fi
    done
}

################################################################################
# odoo_logs [-h] [-n LINES] [-f]
################################################################################
odoo_logs() {
    if [[ "${1:-}" == "-h" ]]; then
        echo "Tail Odoo log file"
        echo "Usage: odoo_logs [-n LINES] [-f]"
        echo "  -f  Follow mode (live tail, default)"
        echo "  Without -f: show last N lines and exit"
        return
    fi
    local lines=50 follow=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n) lines="$2"; shift ;;
            -f) follow=true ;;
            --no-follow) follow=false ;;
        esac
        shift
    done
    if [[ "$follow" == "true" ]]; then
        print_info "Tailing log file: $ODOO_LOG_PATH (last $lines lines)"
        tail -f -n "$lines" "$ODOO_LOG_PATH"
    else
        tail -n "$lines" "$ODOO_LOG_PATH" | _colorize_log
    fi
}

################################################################################
# odoo_errors [-h] [-n COUNT] [--since DATETIME] [--until DATETIME]
#             [--module MODULE] [--traceback] [--count]
################################################################################
odoo_errors() {
    if [[ "${1:-}" == "-h" ]]; then
        echo "Show last N errors from Odoo log"
        echo "Usage: odoo_errors [-n COUNT] [--since DATETIME] [--until DATETIME]"
        echo "                   [--module MODULE] [--traceback] [--count]"
        echo ""
        echo "Options:"
        echo "  -n COUNT           Number of entries (default: 20)"
        echo "  --since DATETIME   Start time (e.g., '2026-03-16' or '2026-03-16 10:00')"
        echo "  --until DATETIME   End time"
        echo "  --module MODULE    Filter by Odoo module (e.g., odoo.addons.sale)"
        echo "  --traceback        Include traceback lines"
        echo "  --count            Only show count"
        return
    fi
    local count=20 since="" until="" module="" traceback_flag="--no-traceback" count_only=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n)          count="$2"; shift ;;
            --since)     since="$2"; shift ;;
            --until)     until="$2"; shift ;;
            --module)    module="$2"; shift ;;
            --traceback) traceback_flag="--traceback" ;;
            --count)     count_only=true ;;
        esac
        shift
    done

    local filter_args=(--level ERROR "$traceback_flag")
    [[ -n "$since" ]] && filter_args+=(--since "$since")
    [[ -n "$until" ]] && filter_args+=(--until "$until")
    [[ -n "$module" ]] && filter_args+=(--module "$module")

    if [[ "$count_only" == "true" ]]; then
        local num
        num=$(_log_filter "${filter_args[@]}" | wc -l)
        print_info "Error count: $num"
        return
    fi

    print_info "Last $count errors from $ODOO_LOG_PATH:"
    echo ""
    _log_filter "${filter_args[@]}" | tail -n "$count" | _colorize_log
}

